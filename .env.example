# Copy this file to `.env` and fill it in. Never commit `.env`.
ADMIN_CODE=change-me-admin
GIRL_CODE=change-me-birthday-girl
TZ=Asia/Kolkata

# TURN for video/voice between different networks (https://www.metered.ca)
METERED_APP=
METERED_API_KEY=
# or your own TURN server
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Persistent storage for gifts + guest list (https://console.upstash.com, Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# optional
# CELEBRATION_AT=2026-11-03T00:00:00
# CELEBRATION_MINUTES=5
# MAX_PLAYERS=30
# KEEP_ALIVE=0
